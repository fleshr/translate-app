exports[`entities/parser/lib/EntisParser/replaceText > should replace text 1`] = `
"
<?xml version="1.0" encoding="utf-8"?>
<xscript>
	<debug editor="test" src="test.txt"/>
	<code>
		<description @l="1" text="test1"/>
		<wait_chgmv/>
		<bg @l="6" src="bg08c" time="1000"/>
		<bgm @l="7" src="bgm06" volume="1."/>
		<se @l="8" buf="1" src="se006" volume="1."/>
		<wait_chgmv/>
		<bg @l="9" src="bg09c" time="1000"/>
		<waitse @l="10" buf="1"/>
		<chgmview @l="11" mode="0"/>
		<msg @l="13" char_id="-1" frame_id="0" name="test4" text="test2" voices="v00000"/>
		<msg @l="14" char_id="0" frame_id="0" name="test5" text="test3" voices="v01000"/>
		<return @l="103" value=""/>
	</code>
</xscript>
"
`;
